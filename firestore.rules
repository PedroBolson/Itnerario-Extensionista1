rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =============================================================================
    // RECURSOS PÚBLICOS - Qualquer pessoa pode ver (tópicos, conteúdos, aulas)
    // =============================================================================
    
    // Tópicos - leitura pública, apenas admins podem modificar
    match /topics/{topicId} {
      allow read: if true; // Qualquer pessoa pode ver os tópicos
      allow create, update, delete: if request.auth != null; // Apenas admins autenticados
    }

    // Conteúdos - leitura pública, apenas admins podem modificar
    match /contents/{contentId} {
      allow read: if true; // Qualquer pessoa pode ver os conteúdos
      allow create, update, delete: if request.auth != null; // Apenas admins autenticados
    }

    // Aulas - leitura pública, apenas admins podem modificar
    match /lessons/{lessonId} {
      allow read: if true; // Qualquer pessoa pode ver as aulas
      allow create, update, delete: if request.auth != null; // Apenas admins autenticados
    }

    // =============================================================================
    // PROGRESSO DE APRENDIZADO - Acesso restrito e controlado
    // =============================================================================
    
    match /learningProgress/{participantId} {
      allow read: if true;

      allow create: if isAdmin() || isValidParticipantCreate(participantId);

      allow update: if isAdmin() || isValidParticipantUpdate(participantId);

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isAdmin() {
    return request.auth != null;
  }

  function isValidParticipantCreate(participantId) {
    return resource == null &&
      hasAllowedParticipantKeys(request.resource.data) &&
      request.resource.data.code == participantId &&
      request.resource.data.code is string &&
      request.resource.data.code.size() == 4 &&
      isValidDisplayName(request.resource.data.displayName) &&
      request.resource.data.createdAt is timestamp &&
      isValidOptionalTimestamp(request.resource.data.lastActiveAt) &&
      (!request.resource.data.keys().hasAny(['lessonProgress']) ||
        isValidLessonProgressMap(request.resource.data.lessonProgress));
  }

  function isValidParticipantUpdate(participantId) {
    return resource != null &&
      hasAllowedParticipantKeys(request.resource.data) &&
      request.resource.data.code == participantId &&
      request.resource.data.code == resource.data.code &&
      request.resource.data.createdAt == resource.data.createdAt &&
      isValidDisplayName(request.resource.data.displayName) &&
      isValidOptionalTimestamp(request.resource.data.lastActiveAt) &&
      (!request.resource.data.keys().hasAny(['lessonProgress']) ||
        isValidLessonProgressMap(request.resource.data.lessonProgress));
  }

  function hasAllowedParticipantKeys(data) {
    return data.keys().hasOnly(['code', 'displayName', 'createdAt', 'lastActiveAt', 'lessonProgress']);
  }

  function isValidDisplayName(value) {
    return value == null || (value is string && value.size() > 0 && value.size() <= 50);
  }

  function isValidOptionalTimestamp(value) {
    return value == null || value is timestamp || value == request.time;
  }

  function isValidLessonProgressMap(progress) {
    return progress is map && progress.values().all(entry => isValidLessonProgressEntry(entry));
  }

  function isValidLessonProgressEntry(entry) {
    return entry is map &&
      entry.keys().hasOnly(['lastPosition', 'duration', 'completed', 'lessonTitle', 'contentTitle', 'contentId', 'topicId', 'topicTitle', 'updatedAt', 'completedAt']) &&
      entry.lastPosition is number && entry.lastPosition >= 0 &&
      entry.duration is number && entry.duration >= 0 &&
      entry.completed is bool &&
      isStringOrNull(entry.lessonTitle) &&
      isStringOrNull(entry.contentTitle) &&
      isStringOrNull(entry.contentId) &&
      isStringOrNull(entry.topicId) &&
      isStringOrNull(entry.topicTitle) &&
      (entry.updatedAt is timestamp || entry.updatedAt == request.time) &&
      (entry.completedAt == null || entry.completedAt is timestamp || entry.completedAt == request.time);
  }

  function isStringOrNull(value) {
    return value == null || value is string;
  }
}
