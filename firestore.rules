rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for course browsing
    match /topics/{topicId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /contents/{contentId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Deny writes elsewhere by default; allow reads for public meta if any
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}

