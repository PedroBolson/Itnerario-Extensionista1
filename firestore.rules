rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =============================================================================
    // RECURSOS PÚBLICOS - Qualquer pessoa pode ver (tópicos, conteúdos, aulas)
    // =============================================================================
    
    // Tópicos - leitura pública, usuários autenticados podem modificar
    match /topics/{topicId} {
      allow read: if true; // Qualquer pessoa pode ver os tópicos
      allow create, update, delete: if request.auth != null;
    }

    // Conteúdos - leitura pública, usuários autenticados podem modificar
    match /contents/{contentId} {
      allow read: if true; // Qualquer pessoa pode ver os conteúdos
      allow create, update, delete: if request.auth != null;
    }

    // Aulas - leitura pública, usuários autenticados podem modificar
    match /lessons/{lessonId} {
      allow read: if true; // Qualquer pessoa pode ver as aulas
      allow create, update, delete: if request.auth != null;
    }

    // =============================================================================
    // USUÁRIOS - Gerenciados apenas por administradores
    // =============================================================================

    match /users/{userId} {
      allow read: if isAdmin() || isCurrentUser(userId);
      allow create: if isAdmin() || canSelfBootstrap(userId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =============================================================================
    // PROGRESSO DE APRENDIZADO - Acesso restrito e controlado
    // =============================================================================
    
    match /learningProgress/{participantId} {
      allow read: if true;

      allow create: if isAdmin() || isValidParticipantCreate(participantId);

      allow update: if isAdmin() || isValidParticipantUpdate(participantId);

      allow delete: if isAdmin();
    }

  }

  match /databases/{database}/documents/{document=**} {
    allow read, write: if false;
  }

  function isAdmin() {
    return request.auth != null
      && exists(/databases/(default)/documents/users/$(request.auth.uid))
      && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      && get(/databases/(default)/documents/users/$(request.auth.uid)).data.isActive != false;
  }

  function isCurrentUser(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  function hasAllowedUserKeys(data) {
    return data.keys().hasOnly(['uid', 'email', 'fullName', 'role', 'isActive', 'createdAt', 'updatedAt']);
  }

  function canSelfBootstrap(userId) {
    return isCurrentUser(userId)
      && !exists(/databases/(default)/documents/users/$(userId))
      && hasAllowedUserKeys(request.resource.data)
      && request.resource.data.uid == userId
      && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == null)
      && (!request.resource.data.keys().hasAny(['isActive']) || request.resource.data.isActive == true);
  }

  function isValidParticipantCreate(participantId) {
    return resource == null &&
      hasAllowedParticipantKeys(request.resource.data) &&
      request.resource.data.code == participantId &&
      request.resource.data.code is string &&
      request.resource.data.code.size() == 4 &&
      isValidDisplayName(request.resource.data.displayName) &&
      request.resource.data.createdAt is timestamp &&
      isValidOptionalTimestamp(request.resource.data.lastActiveAt) &&
      (!request.resource.data.keys().hasAny(['lessonProgress']) ||
        isValidLessonProgressMap(request.resource.data.lessonProgress));
  }

  function isValidParticipantUpdate(participantId) {
    return resource != null &&
      hasAllowedParticipantKeys(request.resource.data) &&
      request.resource.data.code == participantId &&
      request.resource.data.code == resource.data.code &&
      request.resource.data.createdAt == resource.data.createdAt &&
      isValidDisplayName(request.resource.data.displayName) &&
      isValidOptionalTimestamp(request.resource.data.lastActiveAt) &&
      (!request.resource.data.keys().hasAny(['lessonProgress']) ||
        isValidLessonProgressMap(request.resource.data.lessonProgress));
  }

  function hasAllowedParticipantKeys(data) {
    return data.keys().hasOnly(['code', 'displayName', 'createdAt', 'lastActiveAt', 'lessonProgress']);
  }

  function isValidDisplayName(value) {
    return value == null || (value is string && value.size() > 0 && value.size() <= 50);
  }

  function isValidOptionalTimestamp(value) {
    return value == null || value is timestamp || value == request.time;
  }

  function isValidLessonProgressMap(progress) {
    return progress is map;
  }
}
